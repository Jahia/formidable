<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>
<fmdbmix = 'http://www.jahia.org/jahia/fmdb/mix/1.0'>
<fmdbquar = 'http://www.jahia.org/jahia/fmdbquar/nt/1.0'>

// The two checks of the reference hold, stubs for the test suite. Each takes fmdbmix:qualifier as a supertype,
// the marker of the engine: the "Checks" list of a form accepts no other kind of node. The reference hold owns
// a form only when its "Checks" list holds at least one node of these two types.

// Each check carries two settings. onInconclusive: what an INCONCLUSIVE answer means, review (needsReview) or
// reject. onUnavailable: what a failure of the engine of the check means, retry (later, until the attempts are
// exhausted) or reject. There is no "accept": the chain fails closed.

// A stub of a check that asks a remote service, such as a sandbox.
[fmdbquar:remoteStubCheck] > jnt:content, fmdbmix:qualifier, mix:title
 - onInconclusive (string, choicelist[resourceBundle]) = 'review' autocreated indexed=no < 'review', 'reject'
 - onUnavailable (string, choicelist[resourceBundle]) = 'retry' autocreated indexed=no < 'retry', 'reject'

// A stub of a check that reads the file inside the JVM. The chain refuses a list where it reads a file before a
// remote check passed it, unless the run allows it (allowInProcessFirst).
[fmdbquar:inProcessStubCheck] > jnt:content, fmdbmix:qualifier, mix:title
 - onInconclusive (string, choicelist[resourceBundle]) = 'review' autocreated indexed=no < 'review', 'reject'
 - onUnavailable (string, choicelist[resourceBundle]) = 'retry' autocreated indexed=no < 'retry', 'reject'

// --- The quarantine tree: /sites/<site>/formidable-quarantine/<form>/YYYY/MM/DD/<held>, in live ---
// The reference hold writes it with a system session. No type of the tree is a file: no jnt:file, no
// jnt:resource, no jcr:data. No core listener, no /files servlet and no text extraction reads it.

// The root of the tree of a site, named formidable-quarantine. It cuts the ACL inheritance (j:acl with
// j:inherit=false) and holds no access control entry: a role granted on the site gives nothing here.
[fmdbquar:quarantineRoot] > jnt:content, jmix:accessControlled
 + * (fmdbquar:formQuarantine) = fmdbquar:formQuarantine

// The held submissions of one form, named after the identifier of the form in live.
[fmdbquar:formQuarantine] > jnt:content
 - formId (string) mandatory
 + * (fmdbquar:dateFolder) = fmdbquar:dateFolder

// A year, a month or a day of the date of intake.
[fmdbquar:dateFolder] > jnt:content
 + * (fmdbquar:dateFolder) = fmdbquar:dateFolder
 + * (fmdbquar:heldSubmission) = fmdbquar:heldSubmission

// One held submission. The state is one of six strings; the state machine moves it. The names of the fields keep
// the order of the submission: valueFields for the public values, sensitiveFields for the sensitive ones. The
// values live in the two children values and sensitive, apart, and go with the bytes once the submission is
// completed or rejected. checks holds the records of the run, and audit those of the operations: each accepts any
// jnt:content, so a new type of record needs no change here.
[fmdbquar:heldSubmission] > jnt:content
 - state (string) = 'held' mandatory autocreated < 'held', 'checking', 'releasing', 'completed', 'rejected', 'needsReview'
 - createdAt (date) mandatory
 - attempts (long) = 0 autocreated indexed=no
 - nextAttempt (date)
 - completedActions (long) = 0 autocreated indexed=no
 - formId (string) mandatory
 - siteKey (string) indexed=no
 - locale (string) indexed=no
 - originLanguage (string) indexed=no
 - originReferer (string) indexed=no
 - originTimeZone (string) indexed=no
 - valueFields (string) multiple indexed=no
 - sensitiveFields (string) multiple indexed=no
 + values (fmdbquar:values) = fmdbquar:values
 + sensitive (fmdbquar:sensitiveValues) = fmdbquar:sensitiveValues
 + checks (fmdbquar:records) = fmdbquar:records
 + audit (fmdbquar:records) = fmdbquar:records
 + * (fmdbquar:item) = fmdbquar:item

// The public values of a held submission: one multiple string property per field, named after the field.
// The single residual is there for Jahia: setProperty(name, Value[]) of a JCR node wrapper looks up a single
// definition first and refuses the write without one. The repository then stores the property as multiple.
[fmdbquar:values] > jnt:content
 - * (string) indexed=no
 - * (string) multiple indexed=no

// The sensitive values of a held submission, apart from the public ones. No endpoint of the module reads them,
// no log line names them, and they are deleted with the public values. Two residuals, as fmdbquar:values.
[fmdbquar:sensitiveValues] > jnt:content
 - * (string) indexed=no
 - * (string) multiple indexed=no

// One upload of a held submission. Its bytes are a binary property of this type, never jcr:data on a jnt:resource,
// and never indexed. sha256 is computed once at intake; the release computes it again and compares.
[fmdbquar:item] > jnt:content
 - data (binary) indexed=no
 - sha256 (string) mandatory indexed=no
 - size (long) indexed=no
 - fileName (string) indexed=no
 - fieldName (string) indexed=no
 - mimeType (string) indexed=no

// The container of the records under a held submission: the outcomes of the checks and the decision of the run
// (checks/<item>/<check>, checks/decision), and the audit (audit/<n>). Ordered, as an audit is.
[fmdbquar:records] > jnt:content
 orderable
 + * (jnt:content)

// --- The records of the run of the checks, under checks of a held submission ---

// The outcomes of one item, named after the item (checks/item0): one child per check of the list.
[fmdbquar:itemOutcomes] > jnt:content
 + * (fmdbquar:outcome) = fmdbquar:outcome

// The last outcome of one check for one item, named after the check node (checks/item0/remoteCheck). sha256 is the
// SHA-256 of the bytes the outcome was given for: an outcome given for other bytes never counts. No byte here.
// outcome is PASS, FAIL or INCONCLUSIVE (an answer), PENDING (a ticket to poll) or FAILED (the check could not
// answer; retryable says whether a later attempt may). attempts counts the retryable failures since the last answer.
[fmdbquar:outcome] > jnt:content
 - outcome (string) mandatory < 'PASS', 'FAIL', 'INCONCLUSIVE', 'PENDING', 'FAILED'
 - reason (string) indexed=no
 - retryable (boolean) indexed=no
 - at (date) indexed=no
 - ticket (string) indexed=no
 - attempts (long) = 0 autocreated indexed=no
 - sha256 (string) mandatory indexed=no

// Why the run stopped a held submission (checks/decision): a reason of the chain such as CHECK_FAILED or
// FILE_WITHHELD, or INTEGRITY_FAILED, or ACTION_FAILED with the index of the action to resume from. The item, the
// check and the SHA-256 name what the reason is about, when it is about one. The last decision replaces the one before.
[fmdbquar:decision] > jnt:content
 - reason (string) mandatory indexed=no
 - itemName (string) indexed=no
 - checkName (string) indexed=no
 - sha256 (string) indexed=no
 - failedAction (long) indexed=no
 - at (date) indexed=no

// --- The audit of a held submission, under audit ---

// One audit record (audit/record1, record2, ...): an operation of a manager (retry, release, resume, reject) or the
// run of the checks (run), the user that asked for it (none for the run), the state before and after, and when. No
// value and no byte.
[fmdbquar:auditRecord] > jnt:content
 - operation (string) mandatory indexed=no
 - userName (string) indexed=no
 - fromState (string) mandatory indexed=no
 - toState (string) mandatory indexed=no
 - at (date) indexed=no
