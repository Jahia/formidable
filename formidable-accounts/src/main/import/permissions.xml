<?xml version="1.0" encoding="UTF-8"?>
<!-- Who may configure the Create account and Sign in actions: an action runs only when its last author holds this
     permission on it. Under site-admin, so site administrators hold it; an administrator can grant it to another role. -->
<permissions xmlns:jcr="http://www.jcp.org/jcr/1.0">
    <site-admin jcr:primaryType="jnt:permission">
        <formidableAccountsActions jcr:primaryType="jnt:permission"/>
    </site-admin>
</permissions>
