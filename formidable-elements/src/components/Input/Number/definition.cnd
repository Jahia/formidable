// Number input component properties
// Range convention: server-side validation for fmdbmix:numberField types reads the
// minValue/maxValue properties (FormFieldMetadataCollector), shared with the add-on
// rating/scale fields — hence not inputDate's min/max names.
// fmdbmix:numberField also makes the field a conditional-logic source with numeric operators.
[fmdb:inputNumber] > jnt:content, fmdbmix:element, fmdbmix:numberField, fmdbmix:rangeValidationMessages
 - helpText (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) i18n indexed=no
 - required (boolean) = false
 - placeholder (string) i18n indexed=no
 - defaultValue (double)
 - minValue (double)
 - maxValue (double)
 - step (double)
