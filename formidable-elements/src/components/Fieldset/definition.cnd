[fmdb:fieldset] > jnt:content, fmdbmix:formElement, fmdbmix:formContainer, fmdbmix:nonSubmittable
// The help of the group, under its legend, read with the group by assistive technology: the same
// setting as a field's, so that the editor and the markup treat it the same way.
 - helpText (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) i18n indexed=no
 + * (fmdbmix:element) = fmdbmix:element
 + * (fmdbmix:formContent) = fmdbmix:formContent
