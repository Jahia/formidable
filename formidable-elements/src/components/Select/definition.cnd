// Select component properties
[fmdb:select] > jnt:content, fmdbmix:element, fmdbmix:profileMappableField, fmdbmix:choiceField, fmdbmix:validationMessages
 - helpText (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) i18n indexed=no
 - optionsEmptyLabel (string) i18n indexed=no
 // 0.4.0 spelling, kept hidden for this release so that a 0.4 export still imports;
 // renamed at startup by MixinPropertyNamesMigration (#310). Leaves in 0.6.
 - fmdb:optionsEmptyLabel (string) i18n hidden indexed=no
 - size (long)
 - required (boolean) = false
 - multiple (boolean) = false
 - disabled (boolean) = false
 - autofocus (boolean) = false
