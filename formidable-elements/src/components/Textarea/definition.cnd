// The settings once behind an "Advanced settings" switch are a supertype of the textarea since 0.5.0
// (see Input/Text/definition.cnd for the reasoning: no switch, no mixin to add on save, a name kept
// because Jackrabbit accepts a redundant mixin but not a property declared twice).
// cols, form and dirname are hidden: no effect, or an effect nothing reads, in a Formidable form
// (docs/architecture/content-editor-layout.md, "Hidden for good"); a value already set still renders.
[fmdbmix:advancedTextareaSettings] mixin
 - readonly (boolean) = false
 - spellcheck (boolean) = true
 - autofocus (boolean) = false
 - disabled (boolean) = false
 - cols (long) hidden
 - wrap (string,choicelist[resourceBundle]) = 'soft' < 'soft', 'hard', 'off'
 - form (string) hidden indexed=no
 - dirname (boolean) = false hidden

// Textarea component properties
[fmdb:textarea] > jnt:content, fmdbmix:element, fmdbmix:submittableField, fmdbmix:profileMappableField, fmdbmix:textField, fmdbmix:textValidationMessages, fmdbmix:advancedTextareaSettings
 - helpText (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) i18n indexed=no
 - required (boolean) = false
 - placeholder (string) i18n indexed=no
 - defaultValue (string) i18n indexed=no
 - minLength (long)
 - maxLength (long)
 - rows (long)
 - resize (string,choicelist[resourceBundle]) = 'vertical' < 'none', 'both', 'horizontal', 'vertical'
 // Simple string: 'on' (default), 'off', or any HTML5 autocomplete token
 - autocomplete (string) = 'on' autocreated indexed=no
