<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>formidable</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>
    <artifactId>formidable-jexperience-engine</artifactId>
    <name>Formidable jExperience Engine</name>
    <packaging>bundle</packaging>
    <description>The jExperience integration of Formidable forms: profile mapping of the fields, the form's identity in jCustomer, and later the mapping rule, the submission event and the prefill (docs/architecture/jexperience-integration.md)</description>
    <properties>
        <!-- The marker mixin comes from the engine, fmdb:form (which fmdbmix:jExperienceForm extends) from the
             elements, ContextServerService from jExperience. -->
        <jahia-depends>formidable-engine,formidable-elements,jexperience</jahia-depends>
        <sonar.sources>src,pom.xml</sonar.sources>
        <!-- Jahia EE refuses an org.jahia.modules bundle without a valid Jahia-Signature. Computed with keymaker
             (java -jar keymaker-cli.jar pom -f pom.xml -s); the CI's update-signature job keeps it current. -->
        <jahia-module-signature>MCwCFFS8L/8Dgf0DjASs0Va+xTAHPSSYAhQ7IE66CiaGPqKwGXw2BTiZnQ335Q==</jahia-module-signature>
        <!-- 4.2.1 is the compile-time API; the OSGi imports below stay open to any 4.x. The artifact lives in
             Nexus' internal group (jahia-internal in .github/maven.settings.xml and in a developer's settings). -->
        <jexperience.version>4.2.1</jexperience.version>
    </properties>
    <!-- jExperience is not in Nexus' public group: this repository needs the credentials of the
         matching <server id="jahia-internal"> of the builder's settings.xml (.github/maven.settings.xml has it). -->
    <repositories>
        <repository>
            <id>jahia-internal</id>
            <name>Jahia Internal Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/internal</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <dependencies>
        <!-- The engine's exported api only: ChoiceOptionsResolver counts a field's choices as the view does. -->
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>formidable-engine</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <scope>provided</scope>
            <exclusions>
                <!-- Prevent transitive Jahia core dependencies from being used in lieu of explicit declarations. -->
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>jexperience</artifactId>
            <version>${jexperience.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>javax.jcr</groupId>
            <artifactId>jcr</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Referenced by the signatures of the JCR wrappers the tests mock (JCRNodeWrapper reaches
             org.apache.commons.lang.mutable): without it Mockito cannot build the mock type. -->
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Process OSGi Declarative Services annotations -->
                        <_dsannotations>*</_dsannotations>
                        <!-- Nothing is exported: no module consumes these types, and an exported package is a
                             compatibility promise (docs/architecture/dependency-decisions.md). The phase-2 SPI gets
                             its own api package when it lands. -->
                        <Export-Package>!*</Export-Package>
                        <!-- jExperience exports its admin package at the module version (4.2.1) and re-exports the
                             Unomi API at Unomi's major (3.0.0): [4,5) is "any jExperience 4.x", [3,4) "any Unomi 3.x",
                             so a 4.x upgrade of jExperience resolves without a rebuild. -->
                        <Import-Package>
                            org.jahia.modules.formidable.engine.api;version="[0.5,1)",
                            org.jahia.modules.jexperience.admin;version="[4,5)",
                            org.apache.unomi.api;version="[3,4)",
                            org.jahia.services.content,
                            org.jahia.services.content.nodetypes,
                            org.jahia.services.content.nodetypes.initializers,
                            org.jahia.utils.i18n,
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!-- Keeps the declared dependency surface explicit, as formidable-engine does. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- Used through annotations or by the test runtime, not by direct imports. -->
                        <ignoredUnusedDeclaredDependency>org.osgi:osgi.annotation</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>commons-lang:commons-lang</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredUnusedDeclaredDependency>
                        <!-- Inherited from the Jahia modules parent and unused by this module (the servlet API only
                             reaches the CI resolution, as 3.0.1). -->
                        <ignoredUnusedDeclaredDependency>javax.servlet:javax.servlet-api</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>org.springframework:spring-webmvc</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>javax.servlet:jstl</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>org.jahia.server:jahia-taglib</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
