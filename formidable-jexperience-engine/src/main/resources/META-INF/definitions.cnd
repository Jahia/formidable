<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<fmdb = 'http://www.jahia.org/jahia/fmdb/nt/1.0'>
<fmdbmix = 'http://www.jahia.org/jahia/fmdb/mix/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>

// The jExperience mapping of a field: attached to the engine's marker mixin (extends), so it
// reaches every field type that claims fmdbmix:profileMappableField — built-in, extended or
// third-party — without naming one. Shown as the "jExperience" section of the field's editor
// (META-INF/jahia-content-editor-forms/forms/fmdbmix_jExperienceProfileMapping.json); the
// section's switch is the author's "map this field to the visitor profile". dependentProperties:
// the editor asks the property list again when the author switches the field's "multiple"
// toggle or edits a checkbox's choices or options mode, so the offered cardinality follows the
// unsaved values (jcontent re-queries a choicelist only for the properties its selector options
// name, and sends their current values in the initializer's context).
[fmdbmix:jExperienceProfileMapping] mixin
 extends = fmdbmix:profileMappableField
 itemtype = content
 - jExperienceProfileProperty (string, choicelist[formidableJExperienceProfileProperties,dependentProperties='multiple,options,optionsMode,jExperienceSensitive']) indexed=no
 - jExperienceSetStrategy (string, choicelist[resourceBundle]) = 'alwaysSet' autocreated indexed=no < 'alwaysSet', 'setIfMissing'


// The prefill, a mixin of its own rather than a property of the mapping: jcontent gives a mixin that
// extends a type a fieldset with a switch, and what the fieldset holds shows only when the switch is
// on — the one conditional display the editor offers declaratively. Switching it on is the author's
// "fill this field from the visitor profile when the page opens": the profile's value replaces a
// default value the author gave the field, and a field the profile has no value for keeps its default.
// The one option inside says what the page does with the field once the profile's value is in it —
// leave it editable, make it read-only, or hide it, its value still submitted; a field the prefill left
// alone (nothing to write, or the visitor's own input) is never touched by it.
[fmdbmix:jExperiencePrefill] mixin
 extends = fmdbmix:profileMappableField
 itemtype = content
 - jExperiencePrefillThen (string, choicelist[resourceBundle]) = 'editable' autocreated indexed=no < 'editable', 'readOnly', 'hidden'


// A field the author marked sensitive: its value never leaves the site — it is not in the
// submission event, and no mapping can be made on it. The flag has to be answerable before the
// mapping fieldset is switched on, and a switch of its own could contradict that one, so it is a
// property of a mixin jcontent renders without an enable switch: jmix:templateMixin, the one
// supertype that drops it. The mapping's choicelist names this property in its dependentProperties,
// so ticking the box empties the dropdown at once, without a save.
[fmdbmix:jExperienceSensitiveField] > jmix:templateMixin mixin
 extends = fmdbmix:profileMappableField
 itemtype = content
 - jExperienceSensitive (boolean) = false autocreated indexed=no
