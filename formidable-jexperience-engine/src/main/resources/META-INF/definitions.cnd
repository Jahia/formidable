<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<fmdb = 'http://www.jahia.org/jahia/fmdb/nt/1.0'>
<fmdbmix = 'http://www.jahia.org/jahia/fmdb/mix/1.0'>

// The jExperience mapping of a field: attached to the engine's marker mixin (extends), so it
// reaches every field type that claims fmdbmix:profileMappableField — built-in, extended or
// third-party — without naming one. Shown as the "jExperience" section of the field's editor
// (META-INF/jahia-content-editor-forms/forms/fmdbmix_jExperienceProfileMapping.json); the
// section's switch is the author's "map this field to the visitor profile". dependentProperties:
// the editor asks the property list again when the author switches the field's "multiple"
// toggle or edits a checkbox's choices or options mode, so the offered cardinality follows the
// unsaved values (jcontent re-queries a choicelist only for the properties its selector options
// name, and sends their current values in the initializer's context).
[fmdbmix:jExperienceProfileMapping] mixin
 extends = fmdbmix:profileMappableField
 itemtype = content
 - jExperienceProfileProperty (string, choicelist[formidableJExperienceProfileProperties,dependentProperties='multiple,options,optionsMode']) indexed=no
 - jExperiencePrefillFromProfile (boolean) = false autocreated indexed=no
 - jExperienceSetStrategy (string, choicelist[resourceBundle]) = 'alwaysSet' autocreated indexed=no < 'alwaysSet', 'setIfMissing'

