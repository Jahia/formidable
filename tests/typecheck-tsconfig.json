// Type-checks the whole Cypress suite (specs, support, page objects): `yarn typecheck`, run by the
// static-analysis CI job. tsconfig.json covers one folder level only and lib-tsconfig.json the page
// objects, so the specs were never type-checked before (#280). Same strictness as tsconfig.json.
{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "cypress",
      "node",
      "@jahia/cypress",
      "@4tw/cypress-drag-drop",
      "cypress-iframe",
      "cypress-real-events",
      "cypress-wait-until"
    ]
  },
  "include": ["cypress/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
